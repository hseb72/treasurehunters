# Connexion PostgreSQL
DATABASE_URL=postgres://th:th@localhost:5432/treasurehunters
# Adresse d'écoute de l'API
PORT=3000
HOST=0.0.0.0
# Origine autorisée du front (CORS) ; plusieurs valeurs séparées par des virgules
CORS_ORIGIN=http://localhost:4200
# Durée de validité d'une session, en jours
SESSION_DAYS=30

# Génération de chasses (OpenStreetMap + Claude) — désactivée sans clé
ANTHROPIC_API_KEY=
# GENERATOR_MODEL=claude-opus-5
# GENERATOR_EFFORT=medium
# GENERATION_DAILY_QUOTA=5
